# ==============================================================================
# CLOUD SECURE VAULT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application URL (used for OAuth2 redirect URI)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret key for encrypting session cookies (generate random 32+ char string)
SESSION_SECRET=super_secret_session_encryption_key_32_characters_long

# ------------------------------------------------------------------------------
# 1. IBM APP ID (Authentication Service)
# From IBM Cloud -> Resource List -> Services -> App ID -> Applications -> Credentials
# ------------------------------------------------------------------------------
# App ID Client ID
IBM_APPID_CLIENT_ID=
# App ID Secret
IBM_APPID_SECRET=
# App ID Tenant ID
IBM_APPID_TENANT_ID=
# App ID OAuth Server URL (e.g., https://us-south.appid.cloud.ibm.com/oauth/v4/<tenantId>)
IBM_APPID_OAUTH_SERVER_URL=
# App ID Region (e.g. us-south, us-east, eu-gb, eu-de, jp-tok, au-syd)
IBM_APPID_REGION=us-south

# ------------------------------------------------------------------------------
# 2. IBM CLOUDANT (NoSQL Database Service)
# From IBM Cloud -> Resource List -> Databases -> Cloudant -> Service Credentials
# ------------------------------------------------------------------------------
# IBM Cloudant API Key
IBM_CLOUDANT_APIKEY=
# IBM Cloudant Service URL (e.g., https://xxxxxxxx-bluemix.cloudantnosqldb.appdomain.cloud)
IBM_CLOUDANT_URL=
# Target Database Name in Cloudant
IBM_CLOUDANT_DATABASE=cloud_vault_records

# ------------------------------------------------------------------------------
# 3. DEMO / SIMULATION MODE
# Set to 'true' to allow testing and demoing without live IBM Cloud credentials.
# Set to 'false' to enforce strictly live IBM Cloud App ID & Cloudant services.
# ------------------------------------------------------------------------------
DEMO_MODE=true
